# Copy to frontend/.env.production before `npm run build` on the hosted app.
# Do this only after the layerpainter schema, database role, and admin user exist.
# Leave NEXT_PUBLIC_AUTH_REQUIRED unset for local development.

# Same-origin /api so the session cookie is sent with project images.
NEXT_PUBLIC_AUTH_REQUIRED=1
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose the service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
DATABASE_URL=
AUTH_SECRET=

# Next.js rewrite target. Not a public URL.
BACKEND_URL=http://127.0.0.1:8000
